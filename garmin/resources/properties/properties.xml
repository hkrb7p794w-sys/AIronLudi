<!-- Abweichende Worker-Adresse (in der Garmin-Connect-App änderbar). Leer: die beim Build eingesetzte (source/WorkerConfig.mc). -->
<resources>
    <properties>
        <property id="workerUrl" type="string"></property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.workerUrl" title="@Strings.WorkerUrlTitle">
            <settingConfig type="alphaNumeric"/>
        </setting>
    </settings>
</resources>
