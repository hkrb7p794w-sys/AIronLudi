<!-- Worker-Adresse: der Build setzt sie aus der Repo-Variable WATCH_WORKER_URL (garmin.yml); in der Garmin-Connect-App änderbar. -->
<resources>
    <properties>
        <property id="workerUrl" type="string">__WORKER_URL__</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.workerUrl" title="@Strings.WorkerUrlTitle">
            <settingConfig type="alphaNumeric"/>
        </setting>
    </settings>
</resources>
