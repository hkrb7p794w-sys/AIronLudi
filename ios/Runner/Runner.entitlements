<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Health: optional, SideStore mit kostenloser Apple-ID kann es entfernen (Weg ohne ist Pflicht). -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Gemeinsamer Speicher mit den Widgets. SideStore hängt die Team-ID an; die App liest die tatsächliche
	     Gruppe aus dem Provisioning-Profil. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.hkrb7p794w.coach</string>
	</array>
</dict>
</plist>
